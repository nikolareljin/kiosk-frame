#!/usr/bin/env bash
set -euo pipefail
while [ ! -e /var/lib/appliance/firstboot-complete ]; do sleep 1; done


MOUNT=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['paths']['dlna_mount'])
PY
)

mkdir -p "$MOUNT"
exec djmount -o allow_other "$MOUNT"
