#!/bin/sh
set -euo pipefail

ENABLED=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print('yes' if cfg['kiosk'].get('enabled', True) else 'no')
PY
)

if [ "$ENABLED" = "no" ]; then
  exec sleep 3600
fi

USER=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('user','frame'))
PY
)

DISPLAY=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('x_display',':0'))
PY
)

TTY=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('tty','1'))
PY
)

/opt/appliance/photoframe/net_wait.sh 8.8.8.8 60 2 || true

exec su -s /bin/sh -c "startx /opt/appliance/kiosk/xsession.sh -- $DISPLAY vt$TTY" "$USER"
