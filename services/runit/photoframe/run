#!/usr/bin/env bash
set -euo pipefail
while [ ! -e /var/lib/appliance/firstboot-complete ]; do sleep 1; done


ENABLED=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print('yes' if cfg['photoframe'].get('enabled', True) else 'no')
PY
)

if [ "$ENABLED" = "no" ]; then
  exec sleep 3600
fi

exec /opt/appliance/photoframe/watchdog.sh
