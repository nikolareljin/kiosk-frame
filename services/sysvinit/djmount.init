#!/bin/sh
### BEGIN INIT INFO
# Provides:          djmount
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: djmount DLNA mount
### END INIT INFO

set -e

PID=/var/run/djmount.pid
MOUNT=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['paths']['dlna_mount'])
PY
)

case "$1" in
  start)
    mkdir -p "$MOUNT"
    start-stop-daemon --start --background --make-pidfile --pidfile "$PID" --exec /usr/bin/djmount -- -o allow_other "$MOUNT"
    ;;
  stop)
    start-stop-daemon --stop --pidfile "$PID" --retry 5
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    start-stop-daemon --status --pidfile "$PID"
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
 esac
