#!/bin/sh
### BEGIN INIT INFO
# Provides:          kiosk
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Xorg + Chromium kiosk
### END INIT INFO

set -e
PID=/var/run/kiosk.pid

ENABLED=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print('yes' if cfg['kiosk'].get('enabled', True) else 'no')
PY
)

USER=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('user','frame'))
PY
)

DISPLAY=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('x_display',':0'))
PY
)

TTY=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print(cfg['kiosk'].get('tty','1'))
PY
)

case "$1" in
  start)
    if [ "$ENABLED" = "no" ]; then
      exit 0
    fi
    start-stop-daemon --start --background --make-pidfile --pidfile "$PID" --exec /bin/sh -- -c "su -s /bin/sh -c 'startx /opt/appliance/kiosk/xsession.sh -- $DISPLAY vt$TTY' $USER"
    ;;
  stop)
    start-stop-daemon --stop --pidfile "$PID" --retry 5
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    start-stop-daemon --status --pidfile "$PID"
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
 esac
