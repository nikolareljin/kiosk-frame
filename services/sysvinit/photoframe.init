#!/bin/sh
### BEGIN INIT INFO
# Provides:          photoframe
# Required-Start:    $network djmount
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: photoframe watchdog
### END INIT INFO

set -e
PID=/var/run/photoframe.pid

ENABLED=$(/opt/appliance/venv/bin/python - <<'PY'
import yaml
cfg=yaml.safe_load(open('/etc/appliance/appliance.yaml'))
print('yes' if cfg['photoframe'].get('enabled', True) else 'no')
PY
)

case "$1" in
  start)
    if [ "$ENABLED" = "no" ]; then
      exit 0
    fi
    start-stop-daemon --start --background --make-pidfile --pidfile "$PID" --exec /opt/appliance/photoframe/watchdog.sh
    ;;
  stop)
    start-stop-daemon --stop --pidfile "$PID" --retry 5
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    start-stop-daemon --status --pidfile "$PID"
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
 esac
