#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR=/opt/appliance

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root." >&2
    exit 1
  fi
}

detect_init() {
  if [ -d /etc/runit ] && command -v sv >/dev/null 2>&1; then
    echo "runit"
  else
    echo "sysvinit"
  fi
}

restart_services() {
  local init; init=$(detect_init)
  local svcs=(djmount photoframe webui magicmirror calendar_fetch kiosk)
  if [ "$init" = "runit" ]; then
    for svc in "${svcs[@]}"; do
      sv restart "$svc" 2>/dev/null || true
    done
  else
    for svc in "${svcs[@]}"; do
      service "$svc" restart 2>/dev/null || true
    done
  fi
}

require_root

echo "Pulling latest changes..."
git -C "$SCRIPT_DIR" pull

echo "Updating submodules..."
git -C "$SCRIPT_DIR" submodule update --init --recursive

echo "Syncing to $APP_DIR..."
rsync -a --delete "$SCRIPT_DIR/" "$APP_DIR/"

echo "Updating Python dependencies..."
"$APP_DIR/venv/bin/pip" install -r "$APP_DIR/requirements.txt" -q

echo "Restarting services..."
restart_services

echo "Update complete."
